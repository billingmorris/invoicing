<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_total_tax"
              inherit_id="sale.report_saleorder_document">

        <!-- Encabezado de la nueva columna: se inserta despues del ultimo th -->
        <xpath expr="//thead//th[last()]" position="after">
            <th class="text-right">Total con impuestos</th>
        </xpath>

        <!-- Celda de datos: se inserta despues del td que contiene price_subtotal -->
        <xpath expr="//span[@t-field='line.price_subtotal']/.." position="after">
            <td class="text-right">
                <span t-field="line.total_with_tax"
                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
            </td>
        </xpath>

    </template>
</odoo>
