<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.import.xml</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.action_general_configuration"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">

                <div class="app_settings_block" data-string="Importación Facturas XML"
                     id="import_facturas_xml_settings"
                     data-key="import_facturas_xml">

                    <h2>Importación de Facturas XML</h2>
                    <p class="text-muted">
                        Configure los valores por defecto usados cuando se importan
                        facturas de proveedor en formato XML.
                    </p>

                    <div class="row mt16 o_settings_container">

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Producto por defecto</span>
                                <div class="text-muted">
                                    Producto que se asigna cuando un ítem del XML
                                    no se encuentra en Odoo.
                                </div>
                                <div class="content-group mt-2">
                                    <field name="xml_import_default_product_id"
                                           options="{'no_quick_create': True}"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Cuenta contable por defecto</span>
                                <div class="text-muted">
                                    Cuenta de gasto usada cuando no se puede determinar
                                    la cuenta del producto.
                                </div>
                                <div class="content-group mt-2">
                                    <field name="xml_import_default_account_id"
                                           options="{'no_quick_create': True}"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Impuesto de compra por defecto</span>
                                <div class="text-muted">
                                    Impuesto aplicado cuando el porcentaje del XML
                                    no coincide con ningún impuesto de Odoo.
                                </div>
                                <div class="content-group mt-2">
                                    <field name="xml_import_default_tax_id"
                                           options="{'no_quick_create': True}"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Diario de compras</span>
                                <div class="text-muted">
                                    Diario preseleccionado al importar facturas XML.
                                </div>
                                <div class="content-group mt-2">
                                    <field name="xml_import_journal_id"
                                           options="{'no_quick_create': True}"/>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </xpath>
        </field>
    </record>

</odoo>
