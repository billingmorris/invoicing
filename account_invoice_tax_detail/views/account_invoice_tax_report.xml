<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_tax_detail"
              inherit_id="account.report_invoice_document">

        <!--
            XPath sobre el bloque de totales del reporte de factura Odoo 16.
            El reporte account.report_invoice_document en Odoo 16 Community
            tiene una tabla de totales identificada por el campo amount_untaxed.
            Insertamos nuestro cuadro despues de esa tabla de totales.
        -->
        <xpath expr="//t[@t-call='account.document_tax_totals']" position="after">
            <t t-if="o.has_tax_detail">
                <div style="margin-top: 16px; page-break-inside: avoid;">
                    <table class="table table-sm o_main_table" style="width: 55%; margin-left: auto; font-size: 90%;">
                        <thead>
                            <tr style="background-color: #f5f5f5;">
                                <th class="text-left" style="padding: 4px 8px; border-bottom: 1px solid #dee2e6;">
                                    Detalle de impuestos
                                </th>
                                <th class="text-right" style="padding: 4px 8px; border-bottom: 1px solid #dee2e6;">Base</th>
                                <th class="text-right" style="padding: 4px 8px; border-bottom: 1px solid #dee2e6;">
                                    Valor del impuesto
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.tax_detail_ids" t-as="td_line">
                                <tr>
                                    <td style="padding: 4px 8px;">
                                        <span t-esc="td_line.tax_name"/>
                                    </td>
                                    <td class="text-right" style="padding: 4px 8px;">
                                        <span t-field="td_line.base_amount"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-right" style="padding: 4px 8px;">
                                        <span t-field="td_line.tax_amount"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>

    </template>
</odoo>
